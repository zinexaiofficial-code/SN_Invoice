# ==============================================================================
# CADDY REVERSE PROXY CONFIGURATION FOR SN INVOICE
# File Path on VPS: /etc/caddy/Caddyfile (or add to existing Caddyfile)
# ==============================================================================

your-custom-domain.com { # Replace with your domain (e.g. invoice.snadvertising.lk)
    # Automatic HTTPS with Let's Encrypt managed by Caddy

    # Security Headers
    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    # Reverse proxy to Next.js Docker container
    reverse_proxy 127.0.0.1:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }

    # File upload size limit (30MB)
    request_body {
        max_size 30MB
    }

    # Gzip / Zstandard compression
    encode gzip zstd
}

