# SN Invoice — Environment Configuration
# Copy this file to .env.local and populate with your credentials

# Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_NAME="SN Invoice"
NEXT_PUBLIC_APP_URL="https://sn-invoice.vercel.app"
NEXT_PUBLIC_DEFAULT_CURRENCY="LKR"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Asia/Colombo"
NEXT_PUBLIC_DEFAULT_VAT_RATE=18

